# Neon: fill all three required values to enable the live Neon backend.
# DATABASE_URL_UNPOOLED is used by the migration/check scripts when provided.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional alternative backend: Supabase. Neon takes priority when configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@yojanasetu.local
